# Copy this file to .env and fill in ONE of the two keys below.
# analysis/client.py auto-selects a provider: ANTHROPIC_API_KEY is preferred
# if both are set, otherwise it falls back to GEMINI_API_KEY. You can also
# force a provider per-run with `--provider anthropic|gemini` on the CLIs.

# Pay-as-you-go key from https://console.anthropic.com/ (not a Claude.ai/Claude
# Code subscription — those don't work here).
ANTHROPIC_API_KEY=

# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
